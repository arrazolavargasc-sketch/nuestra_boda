{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "invitacion.mp4",
      "use": "@vercel/static"
    },
    {
      "src": "audio.mp3",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpeg",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpg",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/invitacion.mp4",
      "headers": {
        "Content-Type": "video/mp4"
      },
      "dest": "/invitacion.mp4"
    },
    {
      "src": "/audio.mp3",
      "headers": {
        "Content-Type": "audio/mpeg"
      },
      "dest": "/audio.mp3"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}